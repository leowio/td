#!/usr/bin/env bash
# td-cleanup — remove sibling git worktrees / td clones and tear down their Compose stacks
#
# `td -w` / `td -c` place checkouts under dirname(primary)/<name>. Branch or clone names
# with slashes become nested paths (e.g. ../feature/api). Linked worktrees come from
# git worktree list; full clones are discovered under that parent (not only top-level).
# Usage:
#   td-cleanup              interactive multi-select (fzf if available, else numbered menu)
#   td-cleanup --dry-run    show what would be removed
#   td-cleanup -y           skip confirmation prompt
#   td-cleanup --yes

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
TD_OPENCODE_SERVER_CMD="$SCRIPT_DIR/td-opencode-server"

usage() {
    echo "Usage: td-cleanup [--dry-run] [-y|--yes]"
    echo ""
    echo "From any directory inside a git repo, lists linked worktrees and full clones under"
    echo "the same parent directory as the primary repo (including ../segment/more for branch"
    echo "names with slashes), lets you pick"
    echo "entries to remove, runs docker compose down -v where a Compose file exists,"
    echo "then removes git worktrees or deletes clone directories."
}

dry_run=0
assume_yes=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run)
            dry_run=1
            ;;
        -y|--yes)
            assume_yes=1
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
    shift
done

have_cmd() { command -v "$1" >/dev/null 2>&1; }

git_top="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "td-cleanup: not inside a git repository." >&2
    exit 1
}

# One-shot porcelain read: piping git into `head` closes the pipe early; with `pipefail`
# git exits 141 (SIGPIPE) and the script aborts before listing candidates.
wt_porcelain="$(git -C "$git_top" worktree list --porcelain 2>/dev/null || true)"
primary="$(printf '%s\n' "$wt_porcelain" | awk '/^worktree / { print substr($0, 10); exit }')"
if [[ -z "$primary" || ! -d "$primary" ]]; then
    echo "td-cleanup: could not determine primary worktree." >&2
    exit 1
fi

parent="$(dirname "$primary")"

display_slug() {
    local path=$1
    if [[ "$path" == "$parent"/* ]]; then
        echo "${path#$parent/}"
        return 0
    fi
    basename "$path"
}

declare -a paths=()
declare -a kinds=() # worktree | clone

add_candidate() {
    local path=$1 kind=$2
    local p
    for p in "${paths[@]}"; do
        [[ "$p" == "$path" ]] && return 0
    done
    paths+=("$path")
    kinds+=("$kind")
}

while IFS= read -r line; do
    [[ "$line" =~ ^worktree\ (.+)$ ]] || continue
    wt_path="${BASH_REMATCH[1]}"
    [[ "$wt_path" == "$primary" ]] && continue
    [[ -e "$wt_path" ]] || continue
    add_candidate "$wt_path" worktree
done <<< "$wt_porcelain"

# Full clones only: repo roots with a .git directory (not linked worktrees, which use a .git file).
# Scan the whole parent tree so ../feature/foo-style paths are included, but never descend into
# the primary checkout.
if [[ -d "$parent" ]]; then
    while IFS= read -r gitdir; do
        [[ -n "$gitdir" && -d "$gitdir" ]] || continue
        root=$(dirname "$gitdir")
        [[ "$root" == "$primary" ]] && continue
        [[ -f "$root/.git" ]] && continue
        add_candidate "$root" clone
    done < <(
        find "$parent" \( -path "$primary" -o -path "${primary}/*" \) -prune -o \
            -type d -name .git -print 2>/dev/null || true
    )
fi

if [[ ${#paths[@]} -eq 0 ]]; then
    echo "No worktrees or td-style clones found under:"
    echo "  $primary"
    exit 0
fi

compose_hint() {
    local dir=$1
    local f
    for f in docker-compose.yml docker-compose.yaml compose.yml compose.yaml; do
        if [[ -f "$dir/$f" ]]; then
            echo "compose:$f"
            return 0
        fi
    done
    echo "compose:none"
}

docker_teardown() {
    local dir=$1
    if ! have_cmd docker; then
        echo "  (docker not installed — skipping compose teardown)"
        return 0
    fi
    local found=0
    local f
    for f in docker-compose.yml docker-compose.yaml compose.yml compose.yaml; do
        if [[ -f "$dir/$f" ]]; then
            found=1
            break
        fi
    done
    if [[ "$found" -eq 0 ]]; then
        return 0
    fi
    echo "  docker compose down -v --remove-orphans (in $(basename "$dir"))"
    if [[ "$dry_run" -eq 1 ]]; then
        return 0
    fi
    (cd "$dir" && docker compose down -v --remove-orphans) || {
        echo "  warning: docker compose failed — continuing with filesystem removal" >&2
    }
}

remove_one() {
    local path=$1 kind=$2
    docker_teardown "$path"
    if [[ "$dry_run" -eq 1 ]]; then
        if [[ "$kind" == worktree ]]; then
            echo "  git worktree remove $(printf '%q' "$path")"
        else
            echo "  rm -rf $(printf '%q' "$path")"
        fi
        return 0
    fi
    "$TD_OPENCODE_SERVER_CMD" stop "$path"
    if [[ "$kind" == worktree ]]; then
        git -C "$primary" worktree remove --force "$path"
    else
        rm -rf "$path"
    fi
}

declare -a labels=()
declare -i i
for i in "${!paths[@]}"; do
    labels+=("$(display_slug "${paths[$i]}")\t${kinds[$i]}\t$(compose_hint "${paths[$i]}")\t${paths[$i]}")
done

pick_indices() {
    declare -a picked=()
    if have_cmd fzf; then
        local line idx
        while IFS= read -r line; do
            [[ -z "$line" ]] && continue
            idx="${line%%$'\t'*}"
            picked+=("$idx")
        done < <(
            for i in "${!labels[@]}"; do
                printf '%s\t%s\n' "$i" "${labels[$i]}"
            done | fzf --multi --with-nth=2.. --delimiter=$'\t' \
                --header=$'idx\tslug\tkind\tcompose\tpath' \
                --prompt="Toggle entries (tab) > "
        )
        printf '%s\n' "${picked[@]}"
        return 0
    fi

    echo ""
    echo "Checkout directories under:"
    echo "  $parent"
    echo "(Slug column uses paths relative to parent when nested, e.g. feature/api.)"
    local n=1
    for i in "${!paths[@]}"; do
        printf '  [%s] %s  (%s)  %s\n' "$n" "$(display_slug "${paths[$i]}")" "${kinds[$i]}" "$(compose_hint "${paths[$i]}")"
        printf '       %s\n' "${paths[$i]}"
        ((n++)) || true
    done
    echo ""
    read -r -p "Enter indices to remove (e.g. 1 3 4 or 2-5), or empty to cancel: " reply
    [[ -n "$reply" ]] || return 1

    declare -A sel=()
    local tok a b j
    for tok in $reply; do
        if [[ "$tok" =~ ^([0-9]+)-([0-9]+)$ ]]; then
            a="${BASH_REMATCH[1]}"
            b="${BASH_REMATCH[2]}"
            for ((j = a; j <= b; j++)); do
                sel[$j]=1
            done
        elif [[ "$tok" =~ ^[0-9]+$ ]]; then
            sel[$tok]=1
        else
            echo "Invalid token: $tok" >&2
            return 1
        fi
    done

    for j in "${!sel[@]}"; do
        if [[ "$j" -ge 1 && "$j" -le ${#paths[@]} ]]; then
            picked+=("$((j - 1))")
        else
            echo "Index out of range: $j (valid 1-${#paths[@]})" >&2
            return 1
        fi
    done
    printf '%s\n' "${picked[@]}"
}

echo "Primary repo: $primary"
echo ""

mapfile -t chosen < <(pick_indices) || {
    echo "Cancelled."
    exit 0
}

if [[ ${#chosen[@]} -eq 0 ]]; then
    echo "Nothing selected."
    exit 0
fi

echo ""
echo "Will remove:"
for idx in "${chosen[@]}"; do
    printf '  - [%s] %s\n' "${kinds[$idx]}" "${paths[$idx]}"
done

if [[ "$dry_run" -eq 1 ]]; then
    echo ""
    echo "(dry-run — no changes)"
    for idx in "${chosen[@]}"; do
        echo ""
        echo "=== ${paths[$idx]} ==="
        remove_one "${paths[$idx]}" "${kinds[$idx]}"
    done
    exit 0
fi

if [[ "$assume_yes" -eq 0 ]]; then
    read -r -p "Proceed? [y/N] " ans
    case "$ans" in
        y|Y|yes|YES) ;;
        *) echo "Aborted."; exit 1 ;;
    esac
fi

for idx in "${chosen[@]}"; do
    echo ""
    echo "=== ${paths[$idx]} ==="
    remove_one "${paths[$idx]}" "${kinds[$idx]}"
done

echo ""
echo "Done."
