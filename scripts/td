#!/bin/bash
# td - Unified tmux dev session launcher
# Usage:
#   td [ai_args...]                    - Open current directory
#   td [ai_args...] -- <cmd...>        - Run commands in terminal panes
#   td --worktree <branch> [ai_args]   - Open git worktree for branch
#   td -w <branch> [ai_args]           - Short form for --worktree
#   td --clone <name> [ai_args]        - Clone repo to ../<name> and open
#   td -c <name> [ai_args]             - Short form for --clone

set -e

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
TD_RESOURCE_RUN_CMD="$SCRIPT_DIR/td-resource-run"

# Get current dir name, sanitized for workspace naming
get_project_name() {
    local dir="$1"
    basename "$dir" | tr '.:/ ' '----'
}

quote_args() {
    local out=""
    local arg q
    for arg in "$@"; do
        printf -v q '%q' "$arg"
        out+=" $q"
    done
    printf '%s' "${out# }"
}

# Main td workflow: open directory with optional AI command
td_open() {
    local dir="$1"
    shift
    local ai_args=()
    local term_cmds=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --)
                shift
                term_cmds+=("$@")
                break
                ;;
            *)
                ai_args+=("$1")
                ;;
        esac
        shift
    done

    local ai_cmd="${ai_args[*]}"
    
    [[ -z "$ai_cmd" ]] && ai_cmd="${TD_AI_CMD:-claude --dangerously-skip-permissions}"
    
    local project
    project=$(get_project_name "$dir")

    "$TD_RESOURCE_RUN_CMD" "td-$project" --configure

    local layout_cmd
    layout_cmd=$(quote_args td-layout "td-$project" "$dir" "$ai_cmd" "${term_cmds[@]}")

    hyprctl dispatch exec "$layout_cmd"
}

# tdg workflow: git worktree + td
tdg_open() {
    local branch="$1"
    shift
    
    local repo_root
    repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
        echo "Not in a git repository."
        return 1
    }
    
    local worktree_dir="$repo_root/../$branch"
    local remote_branch_exists=false

    if git remote get-url origin >/dev/null 2>&1 && git fetch --quiet origin "+refs/heads/$branch:refs/remotes/origin/$branch" 2>/dev/null; then
        remote_branch_exists=true
    fi
    
    if [[ -d "$worktree_dir" ]]; then
        echo "Worktree already exists at $worktree_dir, using it."
        if [[ "$remote_branch_exists" == true ]]; then
            local current_branch
            current_branch=$(git -C "$worktree_dir" branch --show-current)
            if [[ "$current_branch" == "$branch" ]]; then
                git -C "$worktree_dir" merge --ff-only "origin/$branch"
            else
                echo "Worktree is on '$current_branch', not '$branch'; leaving it unchanged."
            fi
        fi
    else
        if [[ "$remote_branch_exists" == true ]]; then
            if git show-ref --verify --quiet "refs/heads/$branch"; then
                git worktree add "$worktree_dir" "$branch"
                git -C "$worktree_dir" merge --ff-only "origin/$branch"
            else
                git worktree add -b "$branch" "$worktree_dir" "origin/$branch"
            fi
        elif git show-ref --verify --quiet "refs/heads/$branch"; then
            git worktree add "$worktree_dir" "$branch"
        else
            echo "Branch '$branch' not found locally or on origin. Creating new branch."
            git worktree add -b "$branch" "$worktree_dir"
        fi
    fi
    
    td_open "$worktree_dir" "$@"
}

# Clone workflow: full copy of repo + checkout/create branch
clone_open() {
    local name="$1"
    shift

    local repo_root
    repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
        echo "Not in a git repository."
        return 1
    }

    local clone_dir="$repo_root/../$name"

    if [[ -d "$clone_dir" ]]; then
        echo "Clone already exists at $clone_dir, using it."
    else
        local remote
        remote=$(git remote get-url origin 2>/dev/null) || {
            echo "No origin remote found."
            return 1
        }

        git clone "$remote" "$clone_dir"

        cd "$clone_dir"
        if git show-ref --verify --quiet "refs/heads/$name"; then
            git checkout "$name"
        elif git show-ref --verify --quiet "refs/remotes/origin/$name"; then
            git checkout "$name"
        else
            echo "Branch '$name' not found locally or on origin. Creating new branch."
            git checkout -b "$name"
        fi
    fi

    td_open "$clone_dir" "$@"
}

# Print usage
usage() {
    echo "Usage: td [options] [ai_args...]"
    echo ""
    echo "Options:"
    echo "  -w, --worktree <branch>   Open git worktree for branch"
    echo "  -c, --clone <name>        Clone repo to ../<name> and open"
    echo "  -h, --help                Show this help message"
    echo ""
    echo "Examples:"
    echo "  td                        Open current directory"
    echo "  td kimi                   Open current directory with 'kimi' as AI command"
    echo "  td -- 'npm run dev'       Open and run a command in a terminal pane"
    echo "  td codex -- 'npm run dev' 'bun test'"
    echo "  td -w feature-branch      Open worktree for feature-branch"
    echo "  td --worktree foo codex   Open worktree for 'foo' with 'codex' as AI"
    echo "  td -c my-clone            Clone repo to ../my-clone and open"
    echo "  td --clone my-clone kimi  Clone repo and open with 'kimi' as AI"
    echo ""
    echo "Environment:"
    echo "  TD_AI_CMD                 Default AI command when no ai_args are passed"
    echo "  TD_MEMORY_HIGH            Workspace memory pressure threshold (for example 20G)"
    echo "  TD_MEMORY_MAX             Workspace hard memory limit (for example 28G)"
    echo "  TD_MEMORY_SWAP_MAX        Workspace swap limit (for example 4G)"
    echo "  TD_CPU_QUOTA              Workspace CPU quota (for example 400% for four cores)"
}

# Main entry point
main() {
    # Parse options
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -w|--worktree)
                shift
                if [[ $# -eq 0 ]]; then
                    echo "Error: --worktree requires a branch name"
                    exit 1
                fi
                local branch="$1"
                shift
                tdg_open "$branch" "$@"
                return
                ;;
            -c|--clone)
                shift
                if [[ $# -eq 0 ]]; then
                    echo "Error: --clone requires a name"
                    exit 1
                fi
                local name="$1"
                shift
                clone_open "$name" "$@"
                return
                ;;
            -h|--help)
                usage
                return 0
                ;;
            --)
                break
                ;;
            -*)
                # Unknown flag - pass to AI command
                break
                ;;
            *)
                # First non-flag arg - pass all to AI command
                break
                ;;
        esac
    done
    
    # Default: open current directory with remaining args as AI command
    td_open "$PWD" "$@"
}

main "$@"
